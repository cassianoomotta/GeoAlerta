  "typography": {
    "family": "\"Helvetica Neue\", Arial, sans-serif",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "scalePx": {
      "pageTitle": {
        "size": 24,
        "lineHeight": 32
      },
      "sectionTitle": {
        "size": 18,
        "lineHeight": 26
      },
      "body": {
        "size": 16,
        "lineHeight": 24
      },
      "ui": {
        "size": 14,
        "lineHeight": 20
      },
      "metadata": {
        "size": 13,
        "lineHeight": 20
      },
      "caption": {
        "size": 12,
        "lineHeight": 18
      }
    }
  },
  "spacePx": [
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    40,
    48
  ],
  "radiusPx": {
    "control": 8,
    "panel": 12,
    "mobileSurface": 16
  },
  "heightPx": {
    "control": 40,
    "touch": 48,
    "tableComfortable": 52,
    "tableCompact": 44
  },
  "layoutPx": {
    "sidebar": 240,
    "header": 64,
    "detailMin": 320,
    "detailMax": 400,
    "publicFormMax": 560
  },
  "breakpointsPx": {
    "tablet": 640,
    "desktop": 1024,
    "wide": 1440
  },
  "motionMs": {
    "colorMin": 120,
    "colorMax": 160,
    "drawerMin": 180,
    "drawerMax": 220
  },
  "zIndex": {
    "base": 0,
    "mapControls": 10,
    "header": 20,
    "menu": 30,
    "drawer": 40,
    "dialog": 50,
    "toast": 60
  },
  "semantics": {
    "priority": {
      "NORMAL": "neutral",
      "ALTA": "danger"
    },
    "status": {
      "NOVA": "neutral",
      "EM_TRIAGEM": "warning",
      "EM_ATENDIMENTO": "info",
      "RESOLVIDA": "success",
      "CANCELADA": "danger"
    },
    "statusLabels": "Use municipality-configured labels; these codes are stable, labels are not.",
    "riskPolygonFillOpacity": {
      "min": 0.12,
      "max": 0.16
    }
  }
}
