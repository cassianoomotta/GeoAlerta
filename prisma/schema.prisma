generator client {
  provider        = "prisma-client"
  output          = "./generated/client"
  previewFeatures = ["partialIndexes"]
}

/// Shared fixed-minute counter; scoped to the trusted ingestion origin by RLS.
model intake_rate_limits {
  origin_hash String
  minute DateTime @db.Timestamptz(6)
  attempts Int
  @@id([origin_hash, minute])
}

datasource db {
  provider = "postgresql"
}

/// Preserved deployed legacy geometry; never exposed through the Core API.
model legacy_risk_zones {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String
  description String?
  risk_level String @default("Alto")
  color String @default("#ef4444")
  coordinates Json
  geojson Json
  municipio String @default("Santo Antônio da Patrulha")
  created_by String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model occurrences {
  id                              String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type                            String
  description                     String?
  address                         String?
  location                        Unsupported("geography")
  photo_url                       String?
  status                          String                            @default("NOVA")
  reporter_name                   String?
  assigned_to                     String?
  created_at                      DateTime                          @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  legacy_status                   String?
  protocol                        String                            @unique(map: "occurrences_protocol_unique") @default(dbgenerated("nextval('public.occurrence_protocol_seq'::regclass)::text"))
  accuracy                        Float?
  priority                        String                            @default("NORMAL")
  group_id                        String                            @db.Uuid
  version                         Int                               @default(1)
  updated_at                      DateTime                          @default(now()) @db.Timestamptz(6)
  deleted_at                      DateTime?                         @db.Timestamptz(6)
  needs_sanitation                Boolean                           @default(false)
  idempotency_keys                idempotency_keys?
  occurrence_alerts               occurrence_alerts[]
  occurrence_classification_zones occurrence_classification_zones[]
  occurrence_events               occurrence_events[]
  occurrence_private_data         occurrence_private_data?
  groups                          groups                            @relation(fields: [group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([group_id, created_at(sort: Desc), id], map: "occurrences_group_created")
  @@index([location], map: "occurrences_location", type: Gist)
}

/// Publicly selectable occurrence categories. Existing occurrence.type values remain free text for legacy history.
model occurrence_types {
  name          String  @id
  active        Boolean @default(true)
  display_order Int     @db.SmallInt
}

