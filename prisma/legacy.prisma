generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model occurrences {
  id            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          String
  description   String?
  location      Unsupported("geography")?
  photo_url     String?
  status        String                    @default("Aberto")
  reporter_name String?
  assigned_to   String?
  created_at    DateTime                  @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model resource_movements {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource_id String    @db.Uuid
  type        String
  quantity    Decimal   @db.Decimal
  note        String?
  created_by  String?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  resources   resources @relation(fields: [resource_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model resources {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  municipio          String               @default("sa_patrulha")
  name               String
  category           String               @default("Outros")
  quantity           Decimal              @default(0) @db.Decimal
  unit               String               @default("un")
  expiry_date        DateTime?            @db.Date
  shelter_id         String?              @db.Uuid
  status             String               @default("Disponível")
  notes              String?
  created_at         DateTime?            @default(now()) @db.Timestamptz(6)
  resource_movements resource_movements[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model settings {
  key        String    @id
  value      Json      @default("{}")
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model shelter_people {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shelter_id   String    @db.Uuid
  full_name    String
  cpf          String?
  age          Int?
  phone        String?
  has_pet      Boolean   @default(false)
  pet_details  String?
  notes        String?
  check_in_at  DateTime? @default(now()) @db.Timestamptz(6)
  check_out_at DateTime? @db.Timestamptz(6)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  shelters     shelters  @relation(fields: [shelter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model shelters {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  municipio      String           @default("sa_patrulha")
  name           String
  type           String           @default("humano")
  address        String?
  lat            Float?
  lng            Float?
  capacity       Int              @default(0)
  occupied       Int              @default(0)
  phone          String?
  manager        String?
  status         String           @default("Aberto")
  notes          String?
  created_at     DateTime?        @default(now()) @db.Timestamptz(6)
  shelter_people shelter_people[]
}


/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model team_locations {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  team_id     String    @db.Uuid
  team_name   String?
  member_name String?
  lat         Float
  lng         Float
  accuracy    Float?
  sent_at     DateTime? @default(now()) @db.Timestamptz(6)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  teams       teams     @relation(fields: [team_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([team_id, sent_at(sort: Desc)], map: "idx_team_locations_team_sent")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model team_members {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  team_id    String    @db.Uuid
  full_name  String
  role       String    @default("Agente")
  phone      String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  teams      teams     @relation(fields: [team_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model teams {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  municipio      String           @default("sa_patrulha")
  name           String
  organ          String           @default("Defesa Civil")
  type           String           @default("Resgate")
  leader         String?
  phone          String?
  vehicle        String?
  capacity       String?
  status         String           @default("Disponível")
  notes          String?
  created_at     DateTime?        @default(now()) @db.Timestamptz(6)
  team_locations team_locations[]
  team_members   team_members[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model volunteers {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  municipio  String    @default("sa_patrulha")
  full_name  String
  specialty  String    @default("Logística")
  phone      String?
  email      String?
  vehicle    String?
  capacity   String?
  available  Boolean   @default(true)
  status     String    @default("Ativo")
  notes      String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
}
