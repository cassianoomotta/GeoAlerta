{
  "name": "sistema",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/with-env.mjs next dev",
    "build": "node scripts/with-env.mjs next build",
    "start": "node scripts/with-env.mjs next start",
    "lint": "node scripts/with-env.mjs eslint",
    "test:unit": "node scripts/with-env.mjs playwright test --project=unit",
    "test:api": "node scripts/with-env.mjs playwright test --project=api",
    "test:db": "node scripts/with-env.mjs playwright test --project=database --workers=1",
    "test:e2e": "node scripts/with-env.mjs playwright test --project=chromium",
    "test:browsers": "node scripts/with-env.mjs playwright test --project=chromium --project=firefox --project=webkit --project=mobile-chromium --project=mobile-webkit",
    "test:restore": "node --experimental-strip-types scripts/test-restore.ts",
    "test:load": "node --experimental-strip-types scripts/test-load.ts",
    "inventory:legacy": "node scripts/with-env.mjs tsx scripts/inventory-legacy.ts",
    "design:tokens": "node scripts/generate-design-tokens.mjs",
    "design:check": "node scripts/generate-design-tokens.mjs --check",
    "test:design-system": "playwright test --config=playwright.design-system.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@turf/turf": "^7.4.0",
    "bcryptjs": "^3.0.3",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pg": "8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.6.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "postcss": "^8.5.28",
    "prisma": "7.10.0",
    "tailwindcss": "^3.4.19",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "type": "module"
}
